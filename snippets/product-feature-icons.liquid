<style>
  .nh-feature-icons-wrapper{
    display:grid;
    grid-template-columns:repeat(2,1fr);
    gap:22px 30px;

    padding:22px 18px;

    background:#F8F4F7;
  }

  .nh-feature-item{
    display:flex;
    align-items:flex-start;
    gap:14px;
  }

  .nh-feature-icon{
    width:42px;
    height:42px;
    min-width:42px;
    border-radius:50%;
    display:flex;
    align-items:center;
    justify-content:center;

    background:#fff;
  }

  .nh-feature-icon img{
    width:42px;
    height:42px;
    object-fit:contain;
  }

  .nh-feature-text{
    font-size:15px;
    line-height:1.5;
    color:#7B2678;
    font-weight:500;
  }

  @media screen and (max-width:749px){

    .nh-feature-icons-wrapper{
      gap:18px 16px;
      padding:18px 16px;
    }

    .nh-feature-text{
      font-size:14px;
    }

  }
</style>
<div class="nh-feature-icons-wrapper">

  {% for i in (1..4) %}

    {% assign icon_key = 'icon_' | append: i %}
    {% assign text_key = 'text_' | append: i %}

    {% assign icon = block.settings[icon_key] %}
    {% assign text = block.settings[text_key] %}

    {% if icon != blank or text != blank %}

      <div class="nh-feature-item">

        {% if icon != blank %}

          <div class="nh-feature-icon">

            <img
              src="{{ icon | image_url: width: 42 }}"
              alt="{{ text }}"
              loading="lazy"
              width=""
              height=""
            >

          </div>

        {% endif %}

        <div class="nh-feature-text">
          {{ text }}
        </div>

      </div>

    {% endif %}

  {% endfor %}

</div>